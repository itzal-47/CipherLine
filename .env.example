# ============================================================
# CipherLine — Variáveis de ambiente
# ============================================================
# Copia este ficheiro para `.env` e preenche com os teus valores.
# O `.env` NUNCA deve ser commitado (já está no .gitignore).
# ============================================================


# ---------- Supabase (obrigatório) ----------
# Project Settings → API no dashboard Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...


# ---------- Web Push (opcional, mas recomendado) ----------
# Gera com: npx web-push generate-vapid-keys
# A chave pública vai aqui (frontend).
# A privada vai SÓ nas secrets das edge functions do Supabase.
VITE_VAPID_PUBLIC_KEY=BCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------- TURN servers (opcional, para chamadas em redes difíceis) ----------
# Sem isto, o WebRTC usa só STUN públicos do Google — funciona em 90% dos casos,
# mas falha em redes muito restritivas (empresas, algumas operadoras móveis).
#
# Em produção, recomenda-se um TURN próprio ou um serviço como Metered/Twilio.
# O valor por defeito abaixo é o "OpenRelay" público (grátis, mas com limites).
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject
VITE_TURN_URL_TLS=turn:openrelay.metered.ca:443
VITE_TURN_URL_TCP=turn:openrelay.metered.ca:443?transport=tcp